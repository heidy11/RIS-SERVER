# Conexion base de datos
MONGO_URI="mongodb://localhost:27017/ohif-db"
# Clave secreta token de autenticacion
JWT_SECRET="clave-secreta-supersegura"
# CONTRASEÑA POR DEFECTO USUARIO ADMINISTRADOR
ADMIN_EMAIL = "Administrador@gmail.com"
ADMIN_PASSWORD = "1234Qwer"
# Envio automatico
AUTO_ENVIO=false
# Configuración DICOM Local
HOST_DICOM_LOCAL=127.0.0.1
PORT_DICOM_LOCAL=4242
CALLED_AET_DICOM_LOCAL=ORTHANC
CALLING_AET_DICOM_LOCAL=MYAPP #mantenerlo

# Configuración DICOM Externo
HOST_DICOM_EXTERNO=192.168.1.100
PORT_DICOM_EXTERNO=4242
CALLED_AET_DICOM_EXTERNO=EXTERNAL_PACS
CALLING_AET_DICOM_EXTERNO=MYAPP #mantenerlo

#PARA ENVIO AUTONATICO
# AUTO_LOGIN=false #Activar si se desea el envio automatico
#TARGET_URL=https://server3.signa-engineering.com.bo #URL del que enviara los datos
#EMAIL=Administrador@gmail.com
#PASSWORD=1234Qwer

# ─────────────────────────────────────────────────────────────────────────────
# RIS-PACS ADAPTER — Modality Worklist (DCM4CHEE)
# Con MWL_ENABLED=false el RIS funciona exactamente como antes.
# ─────────────────────────────────────────────────────────────────────────────
MWL_ENABLED=false

# Archivo DCM4CHEE. En el lab local (pacs-lab/docker-compose.yml) es:
DCM4CHEE_BASE_URL=http://localhost:8080/dcm4chee-arc
DCM4CHEE_AET=DCM4CHEE
DCM4CHEE_TIMEOUT_MS=10000

# Autenticacion saliente: none (lab) | bearer (produccion con Keycloak)
DCM4CHEE_AUTH_MODE=none
# DCM4CHEE_TOKEN=
# KEYCLOAK_TOKEN_URL=https://sso.hospital.local/realms/pacs/protocol/openid-connect/token
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# Scheduled Station AE Title por modalidad. DEBE salir del DICOM Conformance
# Statement de cada equipo: si no coincide, el equipo no ve su propia worklist.
MWL_STATION_AET_CT=CT01
MWL_STATION_AET_DX=XRAY01
MWL_STATION_AET_CR=XRAY01
MWL_STATION_AET_US=US01

# Raiz OID para el Study Instance UID. 2.25. es la raiz derivada de UUID de
# DICOM PS3.5 B.2 y no requiere registrar un OID propio.
MWL_UID_ROOT=2.25.

# Reintentos y backoff (segundos) del outbox
MWL_MAX_RETRIES=6
MWL_BACKOFF_SECONDS=5,30,120,600,1800,3600
MWL_WORKER_INTERVAL_MS=5000
MWL_WORKER_BATCH_SIZE=10

# Reconciliacion RIS vs DCM4CHEE (0 = desactivada). 900000 ms = 15 min.
MWL_RECONCILIATION_INTERVAL_MS=900000

# ─────────────────────────────────────────────────────────────────────────────
# HL7: reenvío de ORM a dcm4chee para generar la worklist.
# Debe quedar en false mientras el RIS-PACS Adapter (MWL_ENABLED) sea el camino
# oficial: si ambos están activos se crean entradas duplicadas en la worklist.
# ─────────────────────────────────────────────────────────────────────────────
HL7_FORWARD_TO_PACS=false

# ─────────────────────────────────────────────────────────────────────────────
# Valores del PACS del hospital (pendientes de confirmar contra el servidor).
# Descomentar y ajustar cuando haya acceso; reemplazan a los del lab local.
#
#   AE Title indicado por el cliente el 2026-08-31: MEDVIEWER
#   Puerto DICOM indicado: 11111  ← el .env del proyecto tiene 11112 (estándar).
#   Confirmar cuál es, y si MEDVIEWER responde también al modelo MWL o si la
#   worklist se sirve desde otro AE (ver pacs-lab/README.md, hallazgo 1).
# ─────────────────────────────────────────────────────────────────────────────
# DCM4CHEE_BASE_URL=https://<host-nuevo>/dcm4chee-arc
# DCM4CHEE_AET=MEDVIEWER
# DCM4CHEE_MWL_AET=MEDVIEWER

# ─────────────────────────────────────────────────────────────────────────────
# ETAPA 2 — MPPS: estado real del estudio reportado por los equipos.
# El equipo avisa al PACS cuando empieza (N-CREATE) y cuando termina (N-SET).
# El adapter lo consulta y actualiza el estado de la orden, para que nadie
# tenga que marcar a mano "en equipo" y "terminado".
# ─────────────────────────────────────────────────────────────────────────────
MPPS_ENABLED=false
MPPS_POLL_INTERVAL_MS=60000
# Horas hacia atrás que se siguen consultando. Un estudio que el equipo nunca
# cerró no puede quedar consultándose para siempre.
MPPS_LOOKBACK_HOURS=24
